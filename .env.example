# --- What to search for (comma-separated) ---
KEYWORDS=usvisascheduling,美签 放号,美签 新slot,面签 slot 开放,F1签证 放号,B1B2 放号

# Title must match at least one TOPIC term AND one EVENT term (regex, case-insensitive).
# Leave either empty to skip that check.
TOPIC_TERMS=usvisascheduling,美签,面签,签证,\bF-?1\b,\bslot
EVENT_TERMS=放号,新slot,new slots?,开放,刷到,捡漏,有号,出号,刷出,available

# --- Notifications (set one or both) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional tuning ---
# MAX_SCROLLS=4
# DELAY_MIN_MS=2500
# DELAY_MAX_MS=5000
# ALERT_COOLDOWN_HOURS=24   # min hours between "session expired" alerts
# DATA_DIR=.                # where auth.json, seen.json, hits.jsonl live
