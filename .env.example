# --- What to search for (comma-separated) ---
KEYWORDS=usvisascheduling,美签 放号,美签 新slot,面签 slot 开放,F1签证 放号,B1B2 放号

# Title must match at least one TOPIC term AND one EVENT term (regex, case-insensitive,
# comma-separated, so a comma can't appear inside a regex). Leave either empty to skip it.
TOPIC_TERMS=usvisascheduling,美签,面签,签证,\bF-?1\b,\bslot
EVENT_TERMS=放号,新slot,new slots?,开放,刷到,捡漏,有号,出号,刷出,available

# Optional third group: title must ALSO match one of these (e.g. a city). Leave empty for any.
# Beijing only (keep topic/event as above and add the city here):
# EXTRA_TERMS=北京,beijing,\bBJ\b
# Then search for it too, e.g. add to KEYWORDS: 北京 美签 放号,北京使馆 面签 slot

# --- Freshness ---
# Only posts from today and the previous N days (0 = today only, 1 = today + yesterday, off = no limit).
# MAX_POST_AGE_DAYS=1
# TIMEZONE=Asia/Shanghai   # what "today" means; default is this machine's timezone

# --- Notifications: set any/all. Every configured channel gets every hit and alert. ---
DISCORD_WEBHOOK_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Email (e.g. Gmail: smtp.gmail.com / 587 with an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# MAIL_TO=you@gmail.com

# --- Browser ---
# REDNOTE_BROWSER_PATH=/usr/bin/chromium   # system browser on the Pi (install.sh sets this)
# REDNOTE_HEADLESS=0                       # run visibly (login itself uses: rednote_slots.py --login)
# REDNOTE_PROFILE_DIR=./.browser-profile
# REDNOTE_BASE_URL=https://www.rednote.com  # default: follow www.xiaohongshu.com's redirect

# --- Optional tuning ---
# MAX_SCROLLS=4            # max; stops early when nothing new
# MAX_NOTIFY_PER_RUN=10    # extra hits in one run -> one summary message (0 = no cap)
# DELAY_MIN_MS=2500
# DELAY_MAX_MS=5000
# RETRIES=3
# RETRY_DELAY=30
# ALERT_COOLDOWN_HOURS=24   # min hours between "session expired" alerts
# DATA_DIR=.                # where hits.jsonl / seen.json live

# Auto-update: each scheduled run first fast-forwards the code from origin/main.
# REDNOTE_AUTO_UPDATE=0     # disable
# REDNOTE_UPDATE_REF=main   # branch to follow
